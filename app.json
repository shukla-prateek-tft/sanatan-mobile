{
  "expo": {
    "name": "Sanatan Dharma",
    "slug": "sanatan-dharma",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sanatan-dharma",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sanatandharma.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Play audio bhajans",
        "NSCameraUsageDescription": "Capture spiritual moments"
      }
    },
    "android": {
      "package": "com.sanatandharma.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#4A0E0E"
      },
      "permissions": [
        "VIBRATE",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#4A0E0E"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow this app to access your location for accurate Panchang."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
